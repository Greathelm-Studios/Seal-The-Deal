  $s=[Math]::Min(($cellW-20)/$src.Width,($cellH-40)/$src.Height)
  $w=[int]($src.Width*$s); $h=[int]($src.Height*$s)
  $g.DrawImage($src,[int]($x+($cellW-$w)/2),[int]($y+32),$w,$h)
  $src.Dispose()
 }
 $board.Save($outPath,[System.Drawing.Imaging.ImageFormat]::Png)
 $font.Dispose(); $g.Dispose(); $board.Dispose()
}
