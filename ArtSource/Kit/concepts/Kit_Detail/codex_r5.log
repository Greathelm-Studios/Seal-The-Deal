$g.DrawRectangle($glassPen,[single]($ox+$r[0]*$s),[single]($oy+$r[1]*$s),[single]($r[2]*$s),[single]($r[3]*$s))
+        Line $g $routePen ($ox+($r[0]+1)*$s) ($oy+($r[1]+$r[3])*$s) ($ox+($r[0]+1)*$s) ($oy+$r[1]*$s)
