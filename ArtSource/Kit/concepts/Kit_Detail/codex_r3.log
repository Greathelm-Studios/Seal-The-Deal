    $sw = [int]($src.Width / 2)
    $sourceRect = [System.Drawing.Rectangle]::new(($dir*$sw),96,$sw,($src.Height-96))
    $targetRect = [System.Drawing.Rectangle]::new($x,$y,200,202)
    $td.DrawImage($src,$targetRect,$sourceRect,[System.Drawing.GraphicsUnit]::Pixel)
  }
  $src.Dispose()
}
$thumb.Save((Join-Path $detailRoot '"'thumbnail_check_r3.png'),[System.Drawing.Imaging.ImageFormat]::Png)
"'$td.Dispose()
