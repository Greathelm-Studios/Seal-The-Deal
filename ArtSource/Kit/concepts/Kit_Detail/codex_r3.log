$draw.DrawString('"'Carved form / storey-scale cobalt / hard light / five families, ten 
directions',"'$fontSmall,$ink,52,116)
$rects = @(@(48,240,1232,693),@(1304,240,1232,693),@(2560,240,1232,693),@(394,1124,1510,850),@(1936,1124,1510,850))
for ($idx=0; $idx -lt $names.Count; $idx++) {
  $src = [System.Drawing.Image]::FromFile((Join-Path $detailRoot ($names[$idx] + '"'/sheet_r3.png')))
  "'$r = $rects[$idx]
  $draw.DrawString($labels[$idx],$fontLabel,$ink,[single]$r[0],[single]($r[1]-64))
  $draw.DrawImage($src,[System.Drawing.Rectangle]::new($r[0],$r[1],$r[2],$r[3]))
  $src.Dispose()
}
$draw.DrawString('"'A: strongest round-2 idea pushed further.   B: new, wilder alternative.   Dimensions and material 
proposals: README_r3.md',"'$fontSmall,$ink,48,2060)
$canvas.Save((Join-Path $detailRoot '"'contact_sheet_r3.png'),[System.Drawing.Imaging.ImageFormat]::Png)
"'$draw.Dispose()
$canvas.Dispose()
$thumb = New-Object System.Drawing.Bitmap(1128,620)
$td = [System.Drawing.Graphics]::FromImage($thumb)
$td.Clear($white)
$td.InterpolationMode = [System.Drawing.Drawing2D.InterpolationMode]::HighQualityBicubic
$td.TextRenderingHint = [System.Drawing.Text.TextRenderingHint]::AntiAliasGridFit
$thumbTitle = New-Object System.Drawing.Font('"'Arial',22,[System.Drawing.FontStyle]::Bold)
"'$thumbLabel = New-Object System.Drawing.Font('"'Arial',13,[System.Drawing.FontStyle]::Bold)
"'$td.DrawString('"'Round 3 / each direction at 200 px width',"'$thumbTitle,$ink,24,16)
$shortNames = @('"'Facade','Walls + door','Stair','Ceiling + floor','Partition')
for ("'$idx=0; $idx -lt $names.Count; $idx++) {
  $src = [System.Drawing.Image]::FromFile((Join-Path $detailRoot ($names[$idx] + '"'/sheet_r3.png')))
  for ("'$dir=0; $dir -lt 2; $dir++) {
