      m_Calls: []
  m_text: '<b>WASD</b> move    <b>Shift</b> sprint    <b>Mouse</b> look    <b>Q /
    E</b> lean

    <b>Space</b> jump, hold to keep hopping    <b>Space at a ledge</b>
    climb

    <b>Ctrl or C</b> crouch; at a run, slide    <b>Left click</b> fire   
    <b>F1</b> controls    <b>Esc</b> menu

    <b>Pad</b>  sticks move and look   
